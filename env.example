# --- API ---
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000
JWT_SECRET=change-me-in-production

DATABASE_URL=postgresql://realty:realty@localhost:5432/realty
REDIS_URL=redis://localhost:6379
ELASTICSEARCH_URL=http://localhost:9200

# S3 (MinIO locally, AWS S3 in prod — leave S3_ENDPOINT empty for AWS)
S3_ENDPOINT=http://localhost:9000
S3_REGION=eu-central-1
S3_BUCKET=realty-attachments
S3_ACCESS_KEY_ID=minio
S3_SECRET_ACCESS_KEY=minio12345

# Stripe (reservation deposits held on-platform)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Optional: second-pass AI moderation. Rule engine works without it.
ANTHROPIC_API_KEY=
AI_MODERATION_MODEL=claude-haiku-5-5

# Reminder schedule for unanswered buyer messages (minutes)
REMINDER_FIRST_MIN=120
REMINDER_SECOND_MIN=1440

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_MAPBOX_TOKEN=
